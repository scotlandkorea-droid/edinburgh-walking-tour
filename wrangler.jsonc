{
  "name": "edinburgh-walking-tour",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true, "persist": true }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/st-andrews",
      "/st-andrews/",
      "/travel/st-andrews.html",
      "/travel/st-andrews",
      "/travel/st-andrews/",
      "/edinburgh/people/burke-and-hare.html",
      "/edinburgh/places/adam-smith-grave.html",
      "/scotland",
      "/scotland/",
      "/scotland/index.html",
      "/edinburgh/places/city-chambers.html",
      "/edinburgh/places/mercat-cross.html",
      "/places/canongate-overview.html",
      "/places/royal-mile-overview.html",
      "/places/canongate-horatius-bonar.html",
      "/places/canongate-scrooge.html",
      "/places/canongate-holyrood-end.html",
      "/scotland/places/melrose-abbey.html",
      "/assets/city-chambers-courtyard-18363.png",
      "/assets/city-chambers-front-18362.png",
      "/assets/new-college/john-knox-statue-final.png",
      "/assets/new-college/new-college-courtyard.png",
      "/favicon.ico",
      "/assets/ef5aaf4cfaf9f16155eb5ee1cd41d106619e0101e5cda928c3643511b0087258.png",
      "/assets/site.css",
      "/assets/site-header.js",
      "/assets/navigation-system.js",
      "/assets/navigation-data.js",
      "/assets/tour-course-data.js",
      "/assets/search-data.js",
      "/assets/tour-map.js"
    ]
  }
}
